# Copia este archivo con `./go2 init` y ajusta las IP de tu red.

# Robot
GO2_ROBOT_ID=go2_01
GO2_IP=192.168.123.161

# Máquina servidor
GO2_SERVER_PUBLIC_HOST=10.40.5.4
GO2_SERVER_BIND=0.0.0.0
GO2_SERVER_PORT=8000
GO2_DASHBOARD_PORT=8080

# MQTT: el server suele usar el broker local; la Raspberry usa la IP del server.
GO2_SERVER_MQTT_HOST=127.0.0.1
GO2_EDGE_MQTT_HOST=10.40.5.4
GO2_MQTT_PORT=1883
GO2_MQTT_USERNAME=
GO2_MQTT_PASSWORD=
GO2_MQTT_TLS=0

# Debe coincidir en server y Raspberry. Cámbialo fuera de una red de desarrollo.
GO2_EDGE_MEDIA_TOKEN=edge-media-dev-token

# Streams iniciados por el edge (1 = sí, 0 = no)
GO2_ENABLE_CAMERA=1
GO2_ENABLE_AUDIO=1
GO2_ENABLE_LIDAR=1
GO2_DISABLE_TRAFFIC_SAVING=1
GO2_ENABLE_COLORIZATION=0

# Pipeline LiDAR 3D independiente
GO2_LIDAR_SERVER_HOST=10.40.5.4
GO2_LIDAR_SERVER_PORT=8765
GO2_LIDAR_TOKEN=

# SSH legado (opcional)
GO2_SSH_REMOTE=
GO2_REMOTE_PROJECT_ROOT=/home/perrobot/go2_Raspi
