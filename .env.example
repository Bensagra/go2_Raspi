# Set these in the TIC app's environment-variable panel.
# This file is documentation; Uvicorn does not load it automatically.
# TIC supplies PORT and DATA_DIR. Do not override them in the panel.
MQTT_HOST=broker-accessible-from-tic.example
MQTT_PORT=1883
MQTT_TLS=false
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=go2
ROBOT_IDS=go2_01
API_TOKENS=["replace-with-random-operator-token:operator:operator_01","replace-with-random-viewer-token:viewer:viewer_01"]
EDGE_MEDIA_TOKEN=replace-with-random-edge-token
CORS_ORIGINS=*
PERCEPTION_DEVICE=cpu
# JSON array with the same flags supported by server/server_core.py.
SERVER_ARGS=[]
